generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model store_config {
  id                String   @id @default(cuid())
  store_name        String
  slogan            String?
  logo_url          String?
  hero_image_url    String?
  primary_color     String   @default("#C8511B")
  secondary_color   String   @default("#F5A623")
  button_color      String   @default("#C8511B")
  contact_email     String?
  contact_phone     String?
  contact_whatsapp  String?
  address           String?
  sender_email         String?
  facebook_url         String?
  instagram_url        String?
  productos_subtitle   String?
  promociones_subtitle String?
  updated_at           DateTime @updatedAt
}

enum UserRole {
  cliente
  admin
}

model users {
  id            String    @id @db.Uuid
  email         String    @unique
  nombre        String?
  apellido      String?
  telefono      String?
  ruc           String?
  denominacion  String?
  rol           UserRole  @default(cliente)
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now())

  addresses     addresses[]
  orders        orders[]
}

model addresses {
  id          String   @id @default(cuid())
  user_id     String   @db.Uuid
  alias       String
  calle       String
  ciudad      String
  barrio      String?
  referencia  String?
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())

  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders      orders[]
}

model products {
  id           String          @id @default(cuid())
  nombre       String
  slug         String          @unique
  descripcion  String?
  ingredientes String?
  precio       Decimal         @db.Decimal(12, 0)
  stock        Int             @default(0)
  activo       Boolean         @default(true)
  featured     Boolean         @default(false)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  images          product_images[]
  promotion_items promotion_items[]
  order_items     order_items[]
}

model product_images {
  id          String   @id @default(cuid())
  product_id  String
  url         String
  alt_text    String?
  orden       Int      @default(0)
  is_primary  Boolean  @default(false)

  product     products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model promotions {
  id                  String            @id @default(cuid())
  nombre              String
  slug                String            @unique
  descripcion         String?
  precio_promocional  Decimal           @db.Decimal(12, 0)
  activa              Boolean           @default(true)
  fecha_inicio        DateTime?
  fecha_fin           DateTime?
  imagen_url          String?
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  promotion_items     promotion_items[]
  promotion_images    promotion_images[]
  order_items         order_items[]
}

model promotion_images {
  id            String     @id @default(cuid())
  promotion_id  String
  url           String
  alt_text      String?
  orden         Int        @default(0)
  is_primary    Boolean    @default(false)

  promotion     promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
}

model promotion_items {
  id            String     @id @default(cuid())
  promotion_id  String
  product_id    String
  cantidad      Int        @default(1)

  promotion     promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  product       products   @relation(fields: [product_id], references: [id])
}

enum OrderStatus {
  pendiente_confirmacion
  confirmado
  pendiente_pago
  pendiente_envio
  enviado
  entregado
  cancelado
}

model orders {
  id                    String       @id @default(cuid())
  user_id               String       @db.Uuid
  address_id            String?
  ruc_factura           String?
  denominacion_factura  String?
  subtotal              Decimal      @db.Decimal(12, 0)
  total                 Decimal      @db.Decimal(12, 0)
  estado                OrderStatus  @default(pendiente_confirmacion)
  notas_cliente         String?
  notas_admin           String?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  user              users             @relation(fields: [user_id], references: [id])
  address           addresses?        @relation(fields: [address_id], references: [id])
  order_items       order_items[]
  order_status_log  order_status_log[]
}

model order_items {
  id                String      @id @default(cuid())
  order_id          String
  product_id        String?
  promotion_id      String?
  nombre_snapshot   String
  precio_snapshot   Decimal     @db.Decimal(12, 0)
  cantidad          Int
  subtotal          Decimal     @db.Decimal(12, 0)

  order             orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           products?   @relation(fields: [product_id], references: [id], onDelete: SetNull)
  promotion         promotions? @relation(fields: [promotion_id], references: [id], onDelete: SetNull)
}

model order_status_log {
  id               String   @id @default(cuid())
  order_id         String
  estado_anterior  String?
  estado_nuevo     String
  notas            String?
  created_at       DateTime @default(now())

  order            orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
}
